# InferenceOS example configuration.
#
# Copy to `.env` (gitignored) to persist program-level settings across application,
# monitor and resident-server restarts. Environment variables with the same names
# override `.env`. CLI flags override both for a single invocation.

# --------------------------------------------------------------------------- #
# User-controlled optimization preference (economics / search effort only;     #
# never overrides a hard safety gate).                                         #
# --------------------------------------------------------------------------- #
# balanced | performance_first | minimize_optimization_cost | custom
INFERENCEOS_OPTIMIZATION_MODE=balanced

# CUSTOM mode only:
# INFERENCEOS_OPTIMIZATION_MINIMUM_IMPROVEMENT_PERCENT=2.0
# INFERENCEOS_OPTIMIZATION_MAXIMUM_SEARCH_TIME_S=600
# INFERENCEOS_OPTIMIZATION_CUSTOM_DEGRADED_MINIMUM_IMPROVEMENT_PERCENT=1.0
# INFERENCEOS_OPTIMIZATION_CUSTOM_SEVERE_MINIMUM_IMPROVEMENT_PERCENT=0.0
# INFERENCEOS_OPTIMIZATION_CUSTOM_DEGRADED_SEARCH_TIME_MULTIPLIER=1.5
# INFERENCEOS_OPTIMIZATION_CUSTOM_SEVERE_SEARCH_TIME_MULTIPLIER=2.0

# lower_requirement | strict
INFERENCEOS_OPTIMIZATION_DEGRADED_PERFORMANCE_POLICY=lower_requirement

# Performance-state thresholds (relative workload-performance regression).
INFERENCEOS_OPTIMIZATION_DEGRADED_THRESHOLD=0.25
INFERENCEOS_OPTIMIZATION_SEVERE_DEGRADED_THRESHOLD=0.50

# Hard upper bound on any search budget (no unlimited search).
INFERENCEOS_OPTIMIZATION_MAX_SEARCH_TIME_HARD_CAP_S=1200

# Bounded search-duration-aware resume verification.
INFERENCEOS_OPTIMIZATION_RESUME_BASE_TIMEOUT_S=30
INFERENCEOS_OPTIMIZATION_RESUME_SEARCH_FACTOR=0.25
INFERENCEOS_OPTIMIZATION_RESUME_MAX_SEARCH_ALLOWANCE_S=120
INFERENCEOS_OPTIMIZATION_RESUME_HARD_MAX_S=300

# GPU-offload search integration.
INFERENCEOS_PHASE10_GPU_SEARCH_ENABLED=true
INFERENCEOS_PHASE10_GPU_SEARCH_TIME_LIMIT_S=240
